#!/usr/bin/env bash
# Stub `curl` for the sharenow shell-test harness. It replaces the real curl on
# PATH so the canonical scripts run their full logic against canned responses
# with zero network. It emulates only the two invocation shapes the scripts use:
#
#   1. Status-capturing form:  curl -sS -o <tmp> -w "%{http_code}" ...
#        -> writes the canned body to the <tmp> file named by -o
#        -> prints ONLY the HTTP status code on stdout (what -w does here)
#
#   2. Body-to-stdout form:    curl -fsS ... / curl -sS -X ... (no -o, no -w)
#        -> prints the canned body on stdout
#        -> with -f, a >=400 status exits nonzero and prints nothing (like real curl)
#
# The canned response is chosen from env, in priority order:
#   STUB_CURL_STATUS   HTTP status to report/act on (default 200)
#   STUB_CURL_BODY     literal response body (default "{}")
#   STUB_CURL_BODY_FILE  path to a file whose contents are the body (wins over BODY)
#   STUB_CURL_LOG      if set, append one line per call: METHOD<TAB>URL  (for asserting requests)
#   STUB_CURL_BODY_LOG if set, append one line per call: the -d/--data-binary body (for asserting payloads)
#   STUB_CURL_ARGV_LOG if set, append every raw argument as a NUL-delimited field
#                      (for asserting secrets and auth headers never leave the CLI)
#   STUB_CURL_DEVICE_START_BODY / STUB_CURL_DEVICE_TOKEN_BODY override the body
#                      for the browser connection endpoints.
#
# The upload PUT paths in publish.sh/drive.sh use `-o /dev/null -w "%{http_code}"`;
# those are handled by form 1 (writing the body to /dev/null, printing the status),
# which is exactly what the scripts want (they only read the status there).

set -u

status="${STUB_CURL_STATUS:-200}"
if [[ -n "${STUB_CURL_BODY_FILE:-}" && -f "${STUB_CURL_BODY_FILE:-}" ]]; then
  body="$(cat "$STUB_CURL_BODY_FILE")"
else
  body="${STUB_CURL_BODY:-{\}}"
fi

if [[ -n "${STUB_CURL_ARGV_LOG:-}" ]]; then
  printf '%s\0' "$@" >> "$STUB_CURL_ARGV_LOG"
fi

# Parse just enough of the argv to know the output mode, the method, and the URL.
out_file=""
want_status_w=0
fail_mode=0
method="GET"
url=""
data=""
prev=""
for arg in "$@"; do
  case "$prev" in
    -o) out_file="$arg"; prev=""; continue ;;
    -X) method="$arg"; prev=""; continue ;;
    -w) case "$arg" in *"%{http_code}"*) want_status_w=1 ;; esac; prev=""; continue ;;
    -d|--data-binary) data="$arg"; prev=""; continue ;;
  esac
  case "$arg" in
    -o|-X|-w|-d|--data-binary) prev="$arg"; continue ;;
    -f|-sf|-fs|-sSf|-fsS|-fS|-Sf) fail_mode=1; prev=""; continue ;;
    -*) prev=""; continue ;;                 # any other flag (or its value) we ignore
    http://*|https://*) [[ -z "$url" ]] && url="$arg"; prev=""; continue ;;
    *) prev=""; continue ;;
  esac
done

case "$url" in
  */api/auth/agent/device/start)
    body="${STUB_CURL_DEVICE_START_BODY:-$body}"
    status="${STUB_CURL_DEVICE_START_STATUS:-$status}"
    ;;
  */api/auth/agent/device/token)
    body="${STUB_CURL_DEVICE_TOKEN_BODY:-$body}"
    status="${STUB_CURL_DEVICE_TOKEN_STATUS:-$status}"
    ;;
  */api/v1/channels)
    body="${STUB_CURL_CHANNEL_CREATE_BODY:-$body}"
    status="${STUB_CURL_CHANNEL_CREATE_STATUS:-$status}"
    ;;
  */api/v1/channels/*/claim)
    body="${STUB_CURL_CHANNEL_CLAIM_BODY:-$body}"
    status="${STUB_CURL_CHANNEL_CLAIM_STATUS:-$status}"
    ;;
  */api/v1/drives)
    body="${STUB_CURL_DRIVE_CREATE_BODY:-$body}"
    status="${STUB_CURL_DRIVE_CREATE_STATUS:-$status}"
    ;;
  */api/v1/drives/*/files/uploads)
    body="${STUB_CURL_DRIVE_UPLOAD_BODY:-$body}"
    status="${STUB_CURL_DRIVE_UPLOAD_STATUS:-$status}"
    ;;
  */api/v1/drives/*/files/finalize)
    body="${STUB_CURL_DRIVE_FINALIZE_BODY:-$body}"
    status="${STUB_CURL_DRIVE_FINALIZE_STATUS:-$status}"
    ;;
  */api/v1/fullstack/validate)
    body="${STUB_CURL_FULLSTACK_VALIDATE_BODY:-$body}"
    status="${STUB_CURL_FULLSTACK_VALIDATE_STATUS:-$status}"
    ;;
  */api/v1/fullstack)
    body="${STUB_CURL_FULLSTACK_CREATE_BODY:-$body}"
    status="${STUB_CURL_FULLSTACK_CREATE_STATUS:-$status}"
    ;;
  */api/v1/fullstack/*/status)
    body="${STUB_CURL_FULLSTACK_STATUS_BODY:-$body}"
    status="${STUB_CURL_FULLSTACK_STATUS_STATUS:-$status}"
    ;;
  */api/v1/fullstack/*/claim)
    body="${STUB_CURL_FULLSTACK_CLAIM_BODY:-$body}"
    status="${STUB_CURL_FULLSTACK_CLAIM_STATUS:-$status}"
    ;;
  https://*.sharenow.today|https://*.sharenow.today/)
    if [[ -n "${STUB_CURL_FULLSTACK_URL_STATUS_FILE:-}" && -f "$STUB_CURL_FULLSTACK_URL_STATUS_FILE" ]]; then
      status="$(head -n 1 "$STUB_CURL_FULLSTACK_URL_STATUS_FILE")"
      tail -n +2 "$STUB_CURL_FULLSTACK_URL_STATUS_FILE" > "$STUB_CURL_FULLSTACK_URL_STATUS_FILE.next"
      mv "$STUB_CURL_FULLSTACK_URL_STATUS_FILE.next" "$STUB_CURL_FULLSTACK_URL_STATUS_FILE"
    fi
    ;;
  https://upload.test/*)
    body="${STUB_CURL_UPLOAD_BODY:-{}}"
    status="${STUB_CURL_UPLOAD_STATUS:-200}"
    ;;
esac

if [[ "$data" == "@-" ]]; then
  data="$(cat)"
fi
# Aggregate short-flag clusters like -sS or -fsS that we did not special-case.
for arg in "$@"; do
  case "$arg" in
    -*f*|-*F*) case "$arg" in --*) : ;; -*) fail_mode=1 ;; esac ;;
  esac
done

if [[ -n "${STUB_CURL_LOG:-}" ]]; then
  printf '%s\t%s\n' "$method" "$url" >> "$STUB_CURL_LOG"
fi

# Optional request-body log: one line per call with the -d / --data-binary payload
# (empty for bodyless calls). Lets tests assert exactly what was POSTed, e.g. the
# {"fresh":true} create body.
if [[ -n "${STUB_CURL_BODY_LOG:-}" ]]; then
  printf '%s\n' "$data" >> "$STUB_CURL_BODY_LOG"
fi

# -f (fail) semantics: on a >=400 status, real curl writes nothing and exits 22.
if [[ "$fail_mode" -eq 1 && "$status" -ge 400 ]]; then
  exit 22
fi

if [[ -n "$out_file" ]]; then
  printf '%s' "$body" > "$out_file"
fi

if [[ "$want_status_w" -eq 1 ]]; then
  printf '%s' "$status"
elif [[ -z "$out_file" ]]; then
  # Body-to-stdout form (no -o): emit the canned body.
  printf '%s' "$body"
fi

exit 0
